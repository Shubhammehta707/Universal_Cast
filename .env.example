# GEMINI_API_KEY: Optional server-side Gemini API key (configured via Secrets panel; never expose in VITE_*).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the hosted application.
APP_URL="MY_APP_URL"

# Firebase Project ID used by firebase-admin VerifyIdToken on backend (defaults to firebase-applet-config.json).
FIREBASE_PROJECT_ID="gen-lang-client-0443257967"

# Server-side HMAC secret used to sign receiver authorization tokens (set a strong 32+ char secret in production).
SESSION_TOKEN_SECRET="CHANGE_ME_TO_A_32_BYTE_RANDOM_SECRET"

# Optional separate mediasoup SFU microservice URL (omit to run embedded SFU inside the main server).
# SFU_SERVICE_URL="http://127.0.0.1:3001"
SFU_PORT="3001"
SFU_INTERNAL_SECRET="CHANGE_ME_SFU_INTERNAL_SHARED_SECRET"

# mediasoup WebRTC media transport settings
MEDIASOUP_LISTEN_IP="0.0.0.0"
# IMPORTANT in cloud VMs/containers: set to the host's public IPv4 or reachable LAN IP.
MEDIASOUP_ANNOUNCED_IP="127.0.0.1"
MEDIASOUP_RTC_MIN_PORT="40000"
MEDIASOUP_RTC_MAX_PORT="40199"
MEDIASOUP_LOG_LEVEL="warn"
# MEDIASOUP_WORKER_BIN="/app/node_modules/mediasoup/worker/out/Release/mediasoup-worker"
