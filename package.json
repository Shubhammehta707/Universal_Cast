{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.server.json",
    "start": "tsx server.ts",
    "start:prod": "NODE_ENV=production node dist-server/server.js",
    "start:sfu": "tsx server/sfu/sfuServer.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint:rules": "eslint firestore.rules",
    "test": "vitest run",
    "postinstall": "node scripts/ensure-mediasoup-worker.mjs"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^0.546.0",
    "mediasoup": "^3.32.2",
    "mediasoup-client": "^3.26.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "vitest": "^5.1.1",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
